{
  "app": "background-computer-use",
  "remote": {
    "name": "moulik",
    "url": "https://apps.moulik.dev"
  },
  "updater": "sparkle",
  "tagPrefix": "v",
  "builds": {
    "mac": {
      "kind": "native",
      "command": "./scripts/build-app.sh",
      "app": "build/Background Computer Use.app",
      "entitlements": "Resources/BackgroundComputerUse.entitlements",
      "dmgName": "BackgroundComputerUse"
    },
    "windows": {
      "kind": "native",
      "command": "./windows/build.ps1",
      "installer": "windows/dist/BackgroundComputerUse-Setup-{version}.exe",
      "minimumSystemVersion": "10.0"
    }
  }
}
